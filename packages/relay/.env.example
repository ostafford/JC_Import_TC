# Copy to .env and fill in real values. Never commit .env itself.
# The setup wizard (packages/wizard) writes RELAY_BASE_URL automatically once
# it knows the Relay's real public address; the rest can stay at defaults for
# local/dev use (SMTP unset just logs the magic link to the console instead
# of emailing it, which is fine for a first run).

# RELAY_BASE_URL=http://localhost:8788
# PORT=8788
# RELAY_DATA_PATH=./relay.data.json

# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Shared secret the setup wizard uses to call this Relay's one-time bootstrap
# route on first run. Phase A: set the same value in both this file and
# packages/wizard/.env by hand. A later launcher will generate one fresh per
# run instead.
WIZARD_SETUP_TOKEN=
