{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sch-import-importer",
  // Points at a committed, generated bundle, not live TS source — the
  // "Deploy to Cloudflare" button installs from this directory in isolation
  // and can't resolve `@sch-import/shared` as a workspace dependency, so the
  // deployed entry point must already have it inlined. Regenerate via
  // `npm run bundle` (or `npm run deploy`, which bundles first) after any
  // change to this package's src/ or to packages/shared — `npm run dev` uses
  // live src/index.ts instead and ignores this.
  "main": "release/index.js",
  "compatibility_date": "2026-09-25",
  // exceljs (unzipping/parsing the Schedule Export) leans on Node internals
  // (zlib/streams) under the hood — needed for it to run on Workers at all.
  "compatibility_flags": ["nodejs_compat"],

  "observability": { "enabled": true },

  // Cost safety valve, not a functional requirement: this Worker's real CPU
  // work (parsing the Schedule Export, building each write's request body,
  // signing) should stay well under this even for a large export — waiting
  // on the many Connecteam API calls doesn't count against CPU time at all.
  // Caps how much a single Import Run can cost if a future bug loops or
  // hangs, independent of Cloudflare's own default (issue 19).
  "limits": { "cpu_ms": 10000 },

  // The `fetch` handler only validates + enqueues; `queue` does the actual
  // Import Run — a Queue consumer isn't bound by the ~30s cap an HTTP
  // response cycle imposes (issue 14/15's fact-check: up to 15 min/invocation).
  // Create the queue once before first deploy: `wrangler queues create sch-import-triggers`.
  //
  // max_retries: 0 is deliberate, not a placeholder (issue 18, discovered
  // live 2026-09-25): an Import Run's writes aren't idempotent — a retry
  // re-runs every row from scratch with no way to know which already
  // succeeded, so an automatic retry after a partial failure duplicates real
  // Time Activities instead of fixing anything. A failed run must surface to
  // the Admin (see chatConfirmation's crash-notice), never retry blind.
  "queues": {
    "producers": [{ "queue": "sch-import-triggers", "binding": "IMPORT_QUEUE" }],
    "consumers": [{ "queue": "sch-import-triggers", "max_batch_size": 1, "max_retries": 0 }]
  },

  // Secrets (never in this file — `wrangler secret put <NAME>`):
  //   CONNECTEAM_API_TOKEN, WEBHOOK_SHARED_SECRET
  // Vars (plain config, set below or via `wrangler deploy --var`):
  "vars": {
    "CONVERSATION_ID": "6eb46edd-47b5-4cf2-bcbb-b18fdf5ac694",
    "TIME_CLOCK_ID": "19481537",
    "SENDER_ID": "2480518",
    "MANUAL_BREAKS_ENABLED": "true",
    "UNPAID_BREAK_TYPE_ID": "a9618ea2-4b1e-4408-ae1a-821418aa909b",
    "PAID_BREAK_TYPE_ID": "0531a675-0753-4a24-f461-41e1bc5693ae"
    // Optional: CONNECTEAM_BASE_URL
  }
}
