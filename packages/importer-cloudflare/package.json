{
  "name": "@sch-import/importer-cloudflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "wrangler dev src/index.ts",
    "bundle": "wrangler deploy src/index.ts --dry-run --outdir=release && rm -f release/README.md",
    "deploy": "npm run bundle && wrangler deploy"
  },
  "optionalDependencies": {
    "@sch-import/shared": "0.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260925.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
