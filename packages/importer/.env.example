# Copy to .env and fill in real values. Never commit .env itself.
# The setup wizard (packages/wizard) writes these automatically — this file
# is only needed for the CLI `importer setup` fallback path.

CONNECTEAM_API_TOKEN=
WEBHOOK_SHARED_SECRET=

# Optional overrides:
# CONNECTEAM_BASE_URL=
# PORT=8787
# IMPORTER_CONFIG_PATH=./importer.config.json
