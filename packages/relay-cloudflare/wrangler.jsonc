{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sch-import-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-25",
  // Without this, fetch() to another Worker's own *.workers.dev URL gets
  // routed as same-zone traffic and 404s (Cloudflare error 1042) — only an
  // external client reaches it normally. This forces every fetch() to route
  // as genuine public-internet traffic, matching the Importer's endpoint
  // being an arbitrary configurable URL (local, Cloudflare, any account —
  // issue 14's design), not a same-account Worker pinned via a Service Binding.
  "compatibility_flags": ["global_fetch_strictly_public"],

  // Cost safety valve, not a functional requirement: caps CPU time per
  // invocation well above what this Worker's actual work needs (parse a
  // small JSON body, one HMAC sign, a couple of DO calls), so a future bug
  // (an infinite loop, say) can't run up an unexpectedly large bill.
  "limits": { "cpu_ms": 500 },

  // One Durable Object instance per deployment (issue 14: no multi-tenancy
  // to shard within a single company's own self-hosted Relay — ADR 0001).
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "RelayObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RelayObject"] }],

  "observability": { "enabled": true }
}
