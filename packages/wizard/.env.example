# Copy to .env and fill in real values. Never commit .env itself.

# Same value as packages/relay/.env's WIZARD_SETUP_TOKEN — set by hand for
# Phase A; a later launcher will generate one fresh per run and pass it to
# both processes automatically.
WIZARD_SETUP_TOKEN=

# Where the colocated Relay is reachable locally (used both to reach its
# /internal/wizard-bootstrap route and to display in the summary screen).
# RELAY_BASE_URL=http://localhost:8788

# PORT=8789
# CONNECTEAM_BASE_URL=
